# Any OpenAI-compatible Chat Completions endpoint with tool calling.
# Google Gemini (free tier): create a key at https://aistudio.google.com
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# Free-tier quotas are per model. gemini-3.1-flash-lite is fast and was used for the
# evaluation; gemini-3.5-flash allowed only 20 requests/day when tested.
LLM_MODEL=gemini-3.1-flash-lite

# Groq (free tier)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Ollama (local, no key; from Docker use host.docker.internal)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

LLM_TEMPERATURE=0.2
LLM_MAX_TOOL_ROUNDS=6
LLM_MAX_RETRIES=4
LOG_LEVEL=WARNING
